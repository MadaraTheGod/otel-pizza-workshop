# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint, as OTLP via gRPC.
# Copy it from https://app.dash0.com/settings/endpoints → "OTLP via gRPC".
# Check your Dash0 URL to determine your region:
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Which Dash0 dataset the telemetry lands in.
DASH0_DATASET=default

# Optional: tags every service with deployment.environment.name, so you can tell
# your machine's data apart from someone else's in a shared dataset.
DASH0_ENVIRONMENT=workshop

# Optional: your fork's URL. Sent as vcs.repository.url.full, which lets Dash0
# link telemetry back to the code that produced it.
# VCS_REPOSITORY_URL=https://github.com/YOUR-USERNAME/otel-pizza-workshop

# Optional: set to true to run the app with instrumentation switched off.
OTEL_SDK_DISABLED=false

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
